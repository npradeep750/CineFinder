# Backend: keep these values private and use a Supabase service-role key only here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
TMDB_API_KEY=replace-with-tmdb-api-key

# Comma-separated browser origins permitted to call the backend.
CORS_ORIGINS=http://localhost:3000
